# Database
# Local Supabase default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Public site URL used for SEO metadata (sitemap, robots, OpenGraph)
# Defaults to https://infinarad.com if not set
NEXT_PUBLIC_SITE_URL=https://infinarad.com

# ─── Video pipeline ──────────────────────────────────────────────────
# Shared secret required by every /api/video/* endpoint (x-infinarad-token).
# Generate with: openssl rand -hex 32
VIDEO_PIPELINE_TOKEN=

# Script generation (required)
ANTHROPIC_API_KEY=
# VIDEO_SCRIPT_MODEL=claude-opus-5
# VIDEO_SCRIPT_EFFORT=high

# Higgsfield — keyframes (text2image/soul) and clips (image2video/dop).
# Combined form, as printed by the Higgsfield dashboard:
HF_CREDENTIALS=KEY_ID:KEY_SECRET
# ...or the split form: HF_API_KEY= / HF_API_SECRET=

# Narration (optional — without these the narration stage is skipped)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Where narration audio is stored. Falls back to the Higgsfield CDN if unset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_VIDEO_BUCKET=infi-video

# Worker tuning
# VIDEO_WORKER_BUDGET_MS=20000      # wall clock for one worker tick
# VIDEO_LEASE_SECONDS=600           # how long a worker owns a job
# VIDEO_SUBMISSIONS_PER_TICK=4      # provider calls per job per tick
# VIDEO_MAX_ATTEMPTS=3              # retries per stage / per asset
